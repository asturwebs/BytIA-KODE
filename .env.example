# Plantilla de configuración de BytIA KODE — copia a .env y rellena lo tuyo.
#
# ⚠ GOTCHA de la cadena de carga (incidente AST-36: 6.253 restarts del bot):
# config.py carga ./.env (CWD) primero y ~/.bytia-kode/.env (global) después,
# ambas con override=False. Una variable DECLARADA aquí —aunque sea en blanco—
# queda «presente»: ni el global puede rellenarla ni se aplica el default del
# código. Un TELEGRAM_BOT_TOKEN= vacío mantuvo el bot en bucle de reinicios
# durante días aunque el global tenía el token real. La precedencia
# CWD-gana es deliberada (AST-15 T4: el global es escribible por el propio
# agente y no debe pisar la config del proyecto). Por eso TODOS los
# placeholders van COMENTADOS: descomenta sólo lo que rellenes de verdad —
# si no lo usas, deja la línea comentada o bórrala.

# Provider - llama.cpp Router (single port, multi-modelo)
PROVIDER_BASE_URL=http://localhost:8080/v1
PROVIDER_API_KEY=not-needed
PROVIDER_MODEL=auto

# Fallback provider (cloud API) — descomenta y rellena para activarlo
# FALLBACK_BASE_URL=
# FALLBACK_API_KEY=
# FALLBACK_MODEL=

# Telegram bot — token de @BotFather; allowlist de user IDs separados por
# comas (sin ella el bot deniega todos los mensajes: fail-secure)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# Endpoint alternativo del Bot API (servidor local auto-alojado); vacío = api.telegram.org
# TELEGRAM_API_BASE=

# Local models (Ollama)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=gemma4:26b

# General
LOG_LEVEL=INFO
# Path custom para logs (vacío = ~/.bytia-kode/logs/bytia-kode.log)
# LOG_FILE=
DATA_DIR=~/.bytia-kode

# Sandbox - extra binaries (comma-separated, added to default allowlist)
# EXTRA_BINARIES=

# DeepSeek (V4 flash/pro)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
